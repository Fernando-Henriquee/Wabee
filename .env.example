# Copie para .env.local e preencha. NUNCA versione arquivos .env reais.
#
# ── Variáveis do frontend (expostas ao navegador — somente chaves PÚBLICAS) ──
# URL do projeto Supabase (Project Settings → API → Project URL)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
# Chave pública "anon"/"publishable". Segura para o navegador somente porque todas
# as tabelas têm RLS. NUNCA coloque a service_role/secret aqui.
VITE_SUPABASE_ANON_KEY=sua-chave-publica
# Ambiente: local | development | preview | production
VITE_APP_ENV=development

# ── Somente na sua máquina (nunca com prefixo VITE_, nunca na Vercel) ──
# Conexão com o banco para aplicar migrations (npm run db:migrate):
# Supabase → Connect → Session pooler → URI (com a senha do banco).
# SUPABASE_DB_URL=postgresql://postgres.<ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
#
# Contas de acesso: crie o usuário no Supabase (Authentication → Users → Invite) e
# dê o perfil com: npm run member:add -- email@exemplo.com dono "Nome" (usa SUPABASE_DB_URL).
